{
  "name": "flamingo",
  "private": true,
  "version": "1.0.0",
  "description": "FLAMINGO — The Future of Flexible Talent. Workforce marketplace for Flamingo Solution Pvt. Ltd.",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "seed": "npm run seed -w server",
    "test": "npm run test -w server",
    "preview": "npm run preview -w client",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
